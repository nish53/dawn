{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "fv_bestseller_badge": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-bestseller-badge' %}"
          }
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "rating": {
          "type": "rating"
        },
        "price": {
          "type": "price"
        },
        "fv_deal_badges": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-deal-badges' %}"
          }
        },
        "fv_offers_emi": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-offers-emi' %}"
          }
        },
        "fv_membership_teaser": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-membership-teaser' %}"
          }
        },
        "sku": {
          "type": "sku",
          "settings": {
            "text_style": "uppercase"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "fv_size_guide": {
          "type": "popup",
          "settings": {
            "text": "Size Guide",
            "page": "111139389553"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "fv_pincode_wishlist": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-pincode-wishlist' %}"
          }
        },
        "trust_badges": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Free delivery across India",
            "icon_2": "box",
            "heading_2": "Free installation included",
            "icon_3": "return",
            "heading_3": "3-day easy returns"
          }
        },
        "fv_at_a_glance": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'product-at-a-glance' %}"
          }
        },
        "description": {
          "type": "description"
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Delivery",
            "icon": "truck",
            "content": "<p>Free delivery across India. Most orders dispatch within 2-5 business days depending on stock and location.</p>"
          }
        },
        "installation_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Assembly & Installation",
            "icon": "box",
            "content": "<p>Ships knockdown (ready to assemble). Free installation is included where noted, or follow the included DIY assembly guide - most pieces take under an hour with the included hardware.</p>"
          }
        },
        "warranty_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Warranty & Returns",
            "icon": "check_mark",
            "content": "<p>Backed by a manufacturer warranty (see product specifications for duration). 3-day return window from delivery if something isn't right.</p>"
          }
        },
        "fv_faq_emi": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "EMI & Payment Options",
            "icon": "check_mark",
            "content": "<p>Pay via BHIM UPI, Netbanking, Credit/Debit card, or Cash on Delivery. No-cost/standard EMI conversion is available on most major bank credit cards directly from your bank - select it at checkout or convert the transaction afterwards from your card issuer's app, subject to their terms.</p>"
          }
        },
        "fv_faq_delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery Areas & COD",
            "icon": "truck",
            "content": "<p>We deliver across India with free shipping and free installation. Cash on Delivery (COD) is available on eligible orders. Use the pincode checker above to confirm delivery to your area before you order.</p>"
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Frequently Bought Together",
            "make_collapsible_row": false,
            "products_per_page": 4,
            "image_ratio": "square",
            "enable_quick_add": true,
            "pagination_style": "dots",
            "product_list_limit": 10
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "fv_bestseller_badge",
        "vendor",
        "title",
        "rating",
        "price",
        "fv_deal_badges",
        "fv_offers_emi",
        "fv_membership_teaser",
        "sku",
        "variant_picker",
        "fv_size_guide",
        "quantity_selector",
        "buy_buttons",
        "fv_pincode_wishlist",
        "trust_badges",
        "fv_at_a_glance",
        "description",
        "shipping_tab",
        "installation_tab",
        "warranty_tab",
        "fv_faq_emi",
        "fv_faq_delivery",
        "complementary",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "fv-infographic": {
      "type": "product-infographic",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "fv-reviews": {
      "type": "product-reviews",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "fv-infographic",
    "fv-reviews",
    "disclosures",
    "related-products"
  ]
}
