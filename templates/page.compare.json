        "custom_liquid": "<div class=\"page-width\">\n  <h1 style=\"font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:#3B2A20;margin:0 0 6px;\">Compare Products</h1>\n  <p style=\"font-size:14px;color:#8A8378;margin:0 0 28px;\">Saved on this device. Add up to 4 products from any product page using the Compare button.</p>\n  <div id=\"fv-compare-page\"></div>\n</div>\n\n<style>\n  .fv-cmp-table-wrap { overflow-x:auto; }\n  .fv-cmp-table { border-collapse:collapse; width:100%; min-width:520px; }\n  .fv-cmp-table th, .fv-cmp-table td { border:1px solid #EDEBE5; padding:12px 14px; text-align:left; font-size:13.5px; vertical-align:top; }\n  .fv-cmp-table th.fv-cmp-row-label { background:#F7F3EC; color:#8A8378; font-weight:600; width:140px; white-space:nowrap; }\n  .fv-cmp-table td.fv-cmp-col-head { text-align:center; }\n  .fv-cmp-table img { width:100px; height:100px; object-fit:cover; border-radius:8px; display:block; margin:0 auto 10px; }\n  .fv-cmp-table a.fv-cmp-title { font-weight:600; color:#2B2B2B; text-decoration:none; display:block; margin-bottom:6px; }\n  .fv-cmp-remove { border:none; background:none; color:#8A8378; font-size:12px; cursor:pointer; margin-top:8px; text-decoration:underline; }\n  .fv-cmp-remove:hover { color:#c0392b; }\n  .fv-cmp-empty { text-align:center; padding:60px 20px; color:#8A8378; }\n  .fv-cmp-empty a { color:#B5602F; font-weight:600; text-decoration:none; }\n</style>\n\n<script>\n(function () {\n  function getCompare() {\n    try {\n      var raw = window.localStorage.getItem('furniva_compare');\n      var parsed = raw ? JSON.parse(raw) : [];\n      return Array.isArray(parsed) ? parsed : [];\n    } catch (e) { return []; }\n  }\n  function saveCompare(items) {\n    try { window.localStorage.setItem('furniva_compare', JSON.stringify(items)); } catch (e) {}\n  }\n  function cell(value) {\n    return value && value.length ? value : '—';\n  }\n  function render() {\n    var root = document.getElementById('fv-compare-page');\n    var items = getCompare();\n    if (!items.length) {\n      root.innerHTML = '<div class=\"fv-cmp-empty\">You have not added any products to compare yet. <a href=\"/collections/all\">Browse products</a> and use the Compare button on any product page.</div>';\n      return;\n    }\n    var rows = [\n      { label: 'Price', get: function (i) { return cell(i.price); } },\n      { label: 'Dimensions', get: function (i) { return cell(i.dimensions); } },\n      { label: 'Material', get: function (i) { return cell(i.material); } },\n      { label: 'Capacity', get: function (i) { return cell(i.capacity); } },\n      { label: 'Assembly', get: function (i) { return cell(i.assembly); } },\n      { label: 'Warranty', get: function (i) { return cell(i.warranty); } }\n    ];\n    var html = '<div class=\"fv-cmp-table-wrap\"><table class=\"fv-cmp-table\"><thead><tr><th class=\"fv-cmp-row-label\">Product</th>';\n    items.forEach(function (item) {\n      html += '<td class=\"fv-cmp-col-head\">' +\n        (item.image ? '<img src=\"' + item.image + '\" alt=\"\">' : '') +\n        '<a class=\"fv-cmp-title\" href=\"' + item.url + '\">' + item.title + '</a>' +\n        '<button type=\"button\" class=\"fv-cmp-remove\" data-remove-id=\"' + item.id + '\">Remove</button>' +\n        '</td>';\n    });\n    html += '</tr></thead><tbody>';\n    rows.forEach(function (row) {\n      html += '<tr><th class=\"fv-cmp-row-label\">' + row.label + '</th>';\n      items.forEach(function (item) {\n        html += '<td>' + row.get(item) + '</td>';\n      });\n      html += '</tr>';\n    });\n    html += '</tbody></table></div>';\n    root.innerHTML = html;\n    root.querySelectorAll('[data-remove-id]').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var remaining = getCompare().filter(function (i) { return String(i.id) !== String(btn.dataset.removeId); });\n        saveCompare(remaining);\n        render();\n      });\n    });\n  }\n  document.addEventListener('DOMContentLoaded', render);\n})();\n</script>"
