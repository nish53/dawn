ass=\"fv-review-toggle\" style=\"background:none;border:none;color:var(--fv-primary);font-weight:600;font-size:12.5px;padding:0;cursor:pointer;text-decoration:underline;margin-bottom:10px;\">Read more</button>\n        <div style=\"display:flex;align-items:center;justify-content:space-between;\">\n          <div style=\"font-size:12.5px;font-weight:600;color:var(--fv-primary);\">&mdash; Santosh</div>\n          <a href=\"/products/furniva-skyline-6-feet-wooden-two-door-utility-shoe-rack-wenge\" style=\"font-size:11.5px;color:var(--fv-accent);font-weight:600;text-decoration:none;\">Shop this product &rarr;</a>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"fv-review-img-1\" class=\"fv-review-modal-overlay\" style=\"display:none;position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:300;align-items:center;justify-content:center;padding:20px;\">\n      <div style=\"position:relative;max-width:500px;width:100%;\">\n        <button type=\"button\" class=\"fv-review-modal-close\" style=\"position:absolute;top:-40px;right:0;background:rgba(255,255,255,0.15);color:#fff;border:none;border-radius:50%;width:34px;height:34px;font-size:18px;cursor:pointer;\">&times;</button>\n        <img src=\"{{ 'review-santosh-1.png' | asset_url }}\" alt=\"Customer photo - Furniva Skyline Two Door Shoe Rack, Wenge\" style=\"width:100%;border-radius:10px;display:block;\">\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('.fv-review-toggle').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var textEl = btn.previousElementSibling;\n        var expanded = textEl.style.maxHeight === 'none';\n        textEl.style.maxHeight = expanded ? '66px' : 'none';\n        textEl.style.overflow = expanded ? 'hidden' : 'visible';\n        btn.textContent = expanded ? 'Read more' : 'Read less';\n      });\n    });\n    document.querySelectorAll('[data-review-modal]').forEach(function (trigger) {\n      trigger.addEventListener('click', function () {\n        var modal = document.getElementById(trigger.getAttribute('data-review-modal'));\n        if (modal) modal.style.display = 'flex';\n      });\n    });\n    document.querySelectorAll('.fv-review-modal-overlay').forEach(function (overlay) {\n      overlay.querySelector('.fv-review-modal-close').addEventListener('click', function () {\n        overlay.style.display = 'none';\n      });\n      overlay.addEventListener('click', function (e) {\n        if (e.target === overlay) overlay.style.display = 'none';\n      });\n    });\n  })();\n</script>",
