{% comment %}
  Section: Dynamic Announcement Bar
  File Location: sections/announcement-bar.liquid
{% endcomment %}

<div class="fv-announcement-bar" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_vertical }}px 0; border-bottom: 1px solid {{ section.settings.border_color }};">
  <div class="page-width" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
    
    {%- comment -%} Left Link: Track Order / Custom Link {%- endcomment -%}
    {%- if section.settings.show_left_link and section.settings.left_link_text != blank -%}
      {%- assign left_url = section.settings.left_link_url | default: '/pages/track-order' -%}
      <a href="{{ left_url }}" class="fv-topbar-link" style="display:flex; align-items:center; gap:6px; color: {{ section.settings.text_color }}; text-decoration:none; font-size:13px; font-weight:600;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 7.5L12 3 3 7.5m18 0L12 12m9-4.5v9L12 21m0-9L3 7.5m9 9v-9m-9 0v9l9 4.5"/>
        </svg>
        {{ section.settings.left_link_text }}
      </a>
    {%- else -%}
      <div style="width:120px;" class="fv-topbar-spacer"></div>
    {%- endif -%}

    {%- comment -%} Center: Dynamic Marquee Items {%- endcomment -%}
    <div style="flex:1; max-width:65%; overflow:hidden; position:relative; margin:0 auto;">
      <div class="fv-marquee-track" style="display:flex; width:max-content; white-space:nowrap; font-size:13px; font-weight:600; color: {{ section.settings.marquee_text_color }}; text-transform:uppercase; animation: fvMarquee {{ section.settings.marquee_speed }}s linear infinite;">
        {%- if section.blocks.size > 0 -%}
          {%- comment -%} Loop twice to create seamless infinite scroll {%- endcomment -%}
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <span class="fv-marquee-item" {{ block.shopify_attributes }} style="padding:0 20px; flex-shrink:0;">
                  {{ block.settings.text }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- else -%}
          <span class="fv-marquee-item" style="padding:0 20px; flex-shrink:0;">
            Add announcement blocks in theme customizer
          </span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Right Link: Phone Number / Support {%- endcomment -%}
    {%- if section.settings.show_right_link and section.settings.right_link_text != blank -%}
      <a href="{% if section.settings.right_link_url != blank %}{{ section.settings.right_link_url }}{% else %}tel:{{ section.settings.right_link_text | replace: ' ', '' }}{% endif %}" class="fv-topbar-link" style="display:flex; align-items:center; gap:6px; color: {{ section.settings.text_color }}; text-decoration:none; font-size:13px; font-weight:600; white-space:nowrap;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1.1.5 1.1 1.1V20c0 .6-.5 1.1-1.1 1.1C10.6 21.1 2.9 13.4 2.9 3.9 2.9 3.3 3.4 2.8 4 2.8h3.4c.6 0 1.1.5 1.1 1.1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/>
        </svg>
        {{ section.settings.right_link_text }}
      </a>
    {%- else -%}
      <div style="width:120px;" class="fv-topbar-spacer"></div>
    {%- endif -%}

  </div>
</div>

<style>
  .fv-announcement-bar {
    width: 100%;
    position: relative;
    z-index: 30;
  }
  
  .fv-topbar-link:hover {
    opacity: 0.8;
  }

  @keyframes fvMarquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  .fv-marquee-track:hover {
    animation-play-state: paused;
  }

  @media (max-width: 768px) {
    .fv-topbar-spacer { display: none; }
    .fv-announcement-bar .page-width { justify-content: center; gap: 12px; }
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "header",
      "content": "Bar Colors & Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#161D24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Links Text Color",
      "default": "#F4F1EA"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee Text Color",
      "default": "#B5602F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom Border Color",
      "default": "rgba(181, 96, 47, 0.2)"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee Animation Speed",
      "default": 25
    },
    {
      "type": "header",
      "content": "Left Link (e.g. Track Order)"
    },
    {
      "type": "checkbox",
      "id": "show_left_link",
      "label": "Show Left Link",
      "default": true
    },
    {
      "type": "text",
      "id": "left_link_text",
      "label": "Left Link Text",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "left_link_url",
      "label": "Left Link URL"
    },
    {
      "type": "header",
      "content": "Right Link (e.g. Phone Number)"
    },
    {
      "type": "checkbox",
      "id": "show_right_link",
      "label": "Show Right Link",
      "default": true
    },
    {
      "type": "text",
      "id": "right_link_text",
      "label": "Right Link Text",
      "default": "+91 8769325140"
    },
    {
      "type": "url",
      "id": "right_link_url",
      "label": "Right Link Custom URL",
      "info": "Leave blank to automatically create a tel: call link"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free delivery across India · Free installation · COD available"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free delivery across India · Free installation · COD available"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "EXTRA 5% off your first order with code FURNIVA5"
          }
        }
      ]
    }
  ]
}
{% endschema %}