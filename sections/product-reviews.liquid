{% comment %}
  Furniva reviews-with-photos section.
  Data model: Content > Metaobjects > "Furniva product review" entries,
  attached per product via Shopify admin > Product > Metafields > "Reviews".
  Renders nothing if no reviews are attached to this product.
{% endcomment %}
{{ 'furniva-product-page.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign fv_reviews = product.metafields.custom.reviews_list
  assign fv_review_count = fv_reviews.size
-%}
{%- if fv_review_count > 0 -%}
  {%- liquid
    assign fv_rating_sum = 0
    for r in fv_reviews
      assign fv_rating_sum = fv_rating_sum | plus: r.rating.value
    endfor
    assign fv_avg_rating = fv_rating_sum | times: 1.0 | divided_by: fv_review_count
    assign fv_avg_rating_rounded = fv_avg_rating | round
  -%}
  <div
    class="fv-reviews color-{{ section.settings.color_scheme }} gradient"
    style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="fv-reviews__header">
        <h2 class="fv-reviews__heading h2">Customer Reviews</h2>
        <div class="fv-reviews__summary">
          <span class="fv-reviews__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= fv_avg_rating_rounded -%}&#9733;{%- else -%}<span class="fv-reviews__star--empty">&#9733;</span>{%- endif -%}
            {%- endfor -%}
          </span>
          <span class="fv-reviews__avg">{{ fv_avg_rating | round: 1 }} out of 5</span>
          <span class="fv-reviews__count">
            ({{ fv_review_count }} review{% if fv_review_count != 1 %}s{% endif %})
          </span>
        </div>
      </div>
      <div class="fv-reviews__grid">
        {%- for review in fv_reviews -%}
          <article class="fv-review-card">
            {%- if review.review_image.value -%}
              <img
                class="fv-review-card__image"
                src="{{ review.review_image.value | image_url: width: 400 }}"
                alt="{{ review.review_title.value | escape }}"
                loading="lazy"
                width="400"
                height="{{ 400 | divided_by: review.review_image.value.aspect_ratio | default: 400 | ceil }}"
              >
            {%- endif -%}
            <div class="fv-review-card__body">
              <span class="fv-review-card__stars" aria-hidden="true">
                {%- assign fv_r_rating = review.rating.value -%}
                {%- for i in (1..5) -%}
                  {%- if i <= fv_r_rating -%}&#9733;{%- else -%}<span class="fv-reviews__star--empty">&#9733;</span>{%- endif -%}
                {%- endfor -%}
              </span>
              <h3 class="fv-review-card__title">{{ review.review_title.value }}</h3>
              <p class="fv-review-card__text">{{ review.review_body.value }}</p>
              <p class="fv-review-card__meta">
                <span class="fv-review-card__author">{{ review.reviewer_name.value }}</span>
                {%- if review.reviewer_location.value != blank -%}
                  <span class="fv-review-card__location">, {{ review.reviewer_location.value }}</span>
                {%- endif -%}
                {%- if review.verified_purchase.value -%}
                  <span class="fv-review-card__verified">&#10003; Verified Purchase</span>
                {%- endif -%}
              </p>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Furniva: Product reviews",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ]
}
{% endschema %}
