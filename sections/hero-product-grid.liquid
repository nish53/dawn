{% comment %}
  Section: Dynamic Hero Promo Grid
  File Location: sections/hero-promo-grid.liquid
{% endcomment %}

<div class="fv-hero-grid-wrapper" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; background: {{ section.settings.section_bg }};">
  <div class="page-width">
    <div class="fv-hero-layout" style="display: grid; grid-template-columns: 2fr 1fr; gap: {{ section.settings.grid_gap }}px;">
      
      {%- assign main_link = section.settings.main_url | default: '/collections/4-seater-dining-sets' -%}

      <!-- Main Featured Banner (Left / Large) -->
      <a href="{{ main_link }}" class="fv-hero-tile fv-main-tile" style="
        position: relative;
        text-decoration: none;
        color: #FFFFFF;
        border-radius: {{ section.settings.card_radius }}px;
        overflow: hidden;
        display: block;
        min-height: {{ section.settings.min_height_desktop }}px;
        background-color: {{ section.settings.main_bg_color }};
        border: 1px solid {{ section.settings.border_color }};
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      ">
        {%- if section.settings.main_image != blank -%}
          <img src="{{ section.settings.main_image | image_url: width: 1200 }}" alt="{{ section.settings.main_heading | escape }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" loading="lazy">
        {%- endif -%}
        
        <!-- Gradient Overlay -->
        <div style="position: absolute; inset: 0; background: {{ section.settings.main_overlay_gradient }};"></div>
        
        <!-- Text Content -->
        <div style="position: relative; padding: 36px; color: #FFFFFF; max-width: 380px; z-index: 2;">
          {%- if section.settings.main_eyebrow != blank -%}
            <div style="font-family: var(--fv-heading-font, inherit); font-size: 13px; letter-spacing: 0.15em; text-transform: uppercase; color: {{ section.settings.main_eyebrow_color }}; margin-bottom: 6px; font-weight: 600;">
              {{ section.settings.main_eyebrow }}
            </div>
          {%- endif -%}

          {%- if section.settings.main_heading != blank -%}
            <div style="font-family: var(--fv-heading-font, inherit); font-size: {{ section.settings.main_heading_size }}px; font-weight: 600; line-height: 1.2; margin-bottom: 12px; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
              {{ section.settings.main_heading }}
            </div>
          {%- endif -%}

          {%- if section.settings.main_price_tag != blank -%}
            <div style="font-size: 14px; font-weight: 500; background: rgba(0,0,0,0.45); backdrop-filter: blur(4px); display: inline-block; padding: 8px 16px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15);">
              {{ section.settings.main_price_tag }}
            </div>
          {%- endif -%}
        </div>
      </a>

      <!-- Stacked Banners Container (Right / 2 Items) -->
      <div class="fv-side-stack" style="display: flex; flex-direction: column; gap: {{ section.settings.grid_gap }}px;">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url | default: '#' }}" class="fv-hero-tile fv-side-tile" style="
            position: relative;
            text-decoration: none;
            color: #FFFFFF;
            border-radius: {{ section.settings.card_radius }}px;
            overflow: hidden;
            display: block;
            flex: 1;
            min-height: {{ section.settings.min_height_desktop | divided_by: 2 | minus: 6 }}px;
            background-color: {{ block.settings.bg_fallback }};
            border: 1px solid {{ section.settings.border_color }};
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
          " {{ block.shopify_attributes }}>
            
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;" loading="lazy">
            {%- endif -%}

            <!-- Gradient Overlay -->
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22, 29, 36, 0.05) 20%, rgba(22, 29, 36, 0.75) 100%);"></div>

            <!-- Bottom Content -->
            <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; color: #FFFFFF; z-index: 2;">
              {%- if block.settings.heading != blank -%}
                <div style="font-family: var(--fv-heading-font, inherit); font-size: 18px; font-weight: 600; line-height: 1.2;">
                  {{ block.settings.heading }}
                </div>
              {%- endif -%}

              {%- if block.settings.subtext != blank -%}
                <div style="font-size: 13px; opacity: 0.9; margin-top: 4px;">
                  {{ block.settings.subtext }}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<style>
  .fv-hero-tile:hover img {
    transform: scale(1.04);
  }
  
  @media (max-width: 768px) {
    .fv-hero-layout {
      grid-template-columns: 1fr !important;
    }
    .fv-main-tile {
      min-height: 320px !important;
    }
    .fv-side-tile {
      min-height: 180px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Promo Grid",
  "settings": [
    {
      "type": "header",
      "content": "Main Featured Tile (Left)"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "url",
      "id": "main_url",
      "label": "Main Banner Link"
    },
    {
      "type": "text",
      "id": "main_eyebrow",
      "label": "Eyebrow Text",
      "default": "GIF 2026 EARLY ACCESS"
    },
    {
      "type": "color",
      "id": "main_eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#EFE4DC"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "Dining Sets"
    },
    {
      "type": "range",
      "id": "main_heading_size",
      "min": 22,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "text",
      "id": "main_price_tag",
      "label": "Price Badge Text",
      "default": "Starting from ₹11,999"
    },
    {
      "type": "color",
      "id": "main_bg_color",
      "label": "Fallback Background Color",
      "default": "#EFE9DD"
    },
    {
      "type": "text",
      "id": "main_overlay_gradient",
      "label": "CSS Overlay Gradient",
      "default": "linear-gradient(90deg, rgba(22, 29, 36, 0.7) 0%, rgba(22, 29, 36, 0.1) 65%)"
    },
    {
      "type": "header",
      "content": "Layout Controls"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 320,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Desktop Grid Height",
      "default": 420
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section Colors & Padding"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "rgba(181, 96, 47, 0.2)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "side_banner",
      "name": "Side Stack Tile",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Tile Link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Tile Heading",
          "default": "Shop Storage"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Tile Subtitle",
          "default": "Closed utility cabinets & shoe racks"
        },
        {
          "type": "color",
          "id": "bg_fallback",
          "label": "Fallback Background Color",
          "default": "#EDE6D8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Promo Grid",
      "blocks": [
        {
          "type": "side_banner",
          "settings": {
            "heading": "Shop Storage",
            "subtext": "Closed utility cabinets & shoe racks"
          }
        },
        {
          "type": "side_banner",
          "settings": {
            "heading": "Bestsellers",
            "subtext": "Up to 60% off"
          }
        }
      ]
    }
  ]
}
{% endschema %}