{% comment %}
  Section: Dynamic Header & Navigation
  File Location: sections/header.liquid
{% endcomment %}

{{ 'furniva-product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furniva-product-page.js' | asset_url }}" defer="defer"></script>

<div id="fv-main-header" class="fv-header-wrapper" style="
  background: {{ section.settings.bg_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
  --fv-header-fw: {{ section.settings.nav_font_weight }};
  --fv-icon-stroke: {{ section.settings.icon_stroke_width }};
">
  <div class="page-width" style="position:relative; display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; padding-top:{{ section.settings.padding_v }}px; padding-bottom:{{ section.settings.padding_v }}px;">

    <!-- Logo -->
    <a href="/" style="display:inline-flex; flex-shrink:0; text-decoration:none;">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="height:{{ section.settings.logo_height }}px; width:auto; display:block;" loading="lazy">
      {%- else -%}
        <span style="font-family:var(--fv-heading-font, inherit); font-size:22px; font-weight:700; color:{{ section.settings.text_color }}; letter-spacing:0.05em; text-transform:uppercase;">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Dynamic Navigation Menu -->
    <nav style="display:flex; gap:32px; flex-wrap:wrap; align-items:center;">
      {%- assign main_menu = linklists[section.settings.menu] -%}
      {%- if main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          {%- assign has_dropdown = false -%}
          {%- if link.links.size > 0 -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}

          {%- assign mega_block = null -%}
          {%- for block in section.blocks -%}
            {%- assign trigger_clean = block.settings.menu_trigger | strip | downcase -%}
            {%- assign link_clean = link.title | strip | downcase -%}
            {%- if block.type == 'mega_menu' and trigger_clean == link_clean -%}
              {%- assign mega_block = block -%}
            {%- endif -%}
          {%- endfor -%}

          <div class="fv-nav-item" style="position:relative; display:flex; align-items:center;">
            <a href="{{ link.url }}" class="fv-nav-link" style="display:flex; align-items:center; gap:6px; color:{{ section.settings.text_color }}; text-decoration:none; font-weight:var(--fv-header-fw); font-size:14.5px;">
              {{ link.title }}
              {%- if has_dropdown or mega_block != null -%}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><path d="M6 9l6 6 6-6"/></svg>
              {%- endif -%}
            </a>

            {%- comment -%} Mega Menu {%- endcomment -%}
            {%- if mega_block != null -%}
              <div class="fv-dropdown fv-mega-dropdown" style="display:none; position:absolute; top:100%; left:50%; transform:translateX(-50%); background:{{ section.settings.bg_color }}; box-shadow:0 25px 50px -10px rgba(0,0,0,0.5); border:1px solid {{ section.settings.border_color }}; border-radius:8px; padding:40px; z-index:20; width:min(92vw, 1100px); margin-top:10px;">
                <div style="display:grid; grid-template-columns: repeat({{ link.links.size | default: 1 }}, minmax(0, 1fr)){% if mega_block.settings.promo_heading != blank or mega_block.settings.promo_image != blank %} auto{% endif %}; gap:32px;">
                  
                  {%- if link.links.size > 0 -%}
                    {%- for child_link in link.links -%}
                      <div>
                        <div style="font-family:var(--fv-heading-font, inherit); font-weight:600; font-size:14px; color:{{ section.settings.text_color }}; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:10px; margin-bottom:14px; letter-spacing:0.02em;">
                          <a href="{{ child_link.url }}" style="color:inherit; text-decoration:none;">{{ child_link.title }}</a>
                        </div>
                        {%- if child_link.links.size > 0 -%}
                          {%- for grandchild_link in child_link.links -%}
                            <a href="{{ grandchild_link.url }}" class="fv-dropdown-link" style="display:block; padding:6px 0; color:{{ section.settings.text_color }}; text-decoration:none; font-size:13.5px; opacity:0.75; font-weight:var(--fv-header-fw);">
                              {{ grandchild_link.title }}
                            </a>
                          {%- endfor -%}
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- if mega_block.settings.promo_heading != blank or mega_block.settings.promo_image != blank -%}
                    <a href="{{ mega_block.settings.promo_url }}" style="display:block; width:200px; text-decoration:none;" {{ mega_block.shopify_attributes }}>
                      <div style="background:rgba(255,255,255,0.03); height:240px; border-radius:6px; position:relative; overflow:hidden; border:1px solid {{ section.settings.border_color }}; display:flex; align-items:flex-end;">
                        {%- if mega_block.settings.promo_image != blank -%}
                          <img src="{{ mega_block.settings.promo_image | image_url: width: 400 }}" alt="{{ mega_block.settings.promo_heading }}" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:1;" loading="lazy">
                        {%- endif -%}
                        {%- if mega_block.settings.promo_heading != blank -%}
                          <div style="width:100%; background:{{ section.settings.accent_color }}; color:#FFFFFF; padding:12px; font-size:11px; font-weight:700; letter-spacing:0.06em; text-align:center; text-transform:uppercase; position:relative; z-index:2;">
                            {{ mega_block.settings.promo_heading }}
                          </div>
                        {%- endif -%}
                      </div>
                    </a>
                  {%- endif -%}

                </div>
              </div>

            {%- elsif has_dropdown -%}
              {%- comment -%} Standard Dropdown {%- endcomment -%}
              <div class="fv-dropdown fv-standard-dropdown" style="display:none; position:absolute; top:100%; left:0; background:{{ section.settings.bg_color }}; box-shadow:0 20px 30px rgba(0,0,0,0.45); border:1px solid {{ section.settings.border_color }}; border-radius:6px; padding:12px 0; min-width:200px; z-index:10; margin-top:10px;">
                {%- for child_link in link.links -%}
                  <a href="{{ child_link.url }}" class="fv-dropdown-link" style="display:block; padding:8px 20px; color:{{ section.settings.text_color }}; text-decoration:none; font-size:13.5px; font-weight:var(--fv-header-fw);">
                    {{ child_link.title }}
                  </a>
                {%- endfor -%}
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <!-- Dynamic Action Icons -->
    <div style="display:flex; align-items:center; gap:20px;">
      <a href="/search" class="fv-icon-link" style="color:{{ section.settings.text_color }};" title="Search" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </a>
      <a href="/account" class="fv-icon-link" style="color:{{ section.settings.text_color }};" title="Account" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
      </a>
      <a href="/pages/wishlist" class="fv-icon-link" style="color:{{ section.settings.text_color }};" title="Wishlist" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.5 2 5 5.6 5c2 0 3.4 1 4.4 2.4C11 6 12.4 5 14.4 5 18 5 19.6 8.5 22 11.7 19.5 16.4 12 21 12 21z"/></svg>
      </a>
      <a href="/pages/compare" class="fv-icon-link" style="color:{{ section.settings.text_color }};" title="Compare" aria-label="Compare">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><path d="M7 3v18M17 3v18M3 8l4-5 4 5M13 16l4 5 4-5"/></svg>
      </a>
      <a href="/cart" class="fv-icon-link" style="position:relative; color:{{ section.settings.text_color }};" title="Cart" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="var(--fv-icon-stroke)"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
        <span style="position:absolute; top:-6px; right:-8px; background:{{ section.settings.accent_color }}; color:#FFFFFF; font-size:10px; font-weight:700; width:16px; height:16px; border-radius:50%; display:flex; align-items:center; justify-content:center;">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</div>

<style>
  /* Fix sticky behavior by overriding parent container overflow */
  #shopify-section-{{ section.id }} {
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
  }

  .fv-header-wrapper {
    position: relative;
    width: 100%;
    transition: box-shadow 0.3s ease;
  }
  
  .fv-header-wrapper.fv-is-stuck {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .fv-nav-item.fv-menu-open .fv-dropdown { display: block !important; }
  .fv-dropdown-link:hover { opacity: 1 !important; color: {{ section.settings.accent_color }} !important; }
  .fv-nav-link:hover { opacity: 0.8; color: {{ section.settings.accent_color }} !important; }
  .fv-icon-link:hover { color: {{ section.settings.accent_color }} !important; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.fv-nav-item').forEach(function (item) {
      var closeTimer = null;
      var dropdown = item.querySelector('.fv-dropdown');
      var trigger = item.querySelector('.fv-nav-link');

      var open = function () {
        if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
        document.querySelectorAll('.fv-nav-item.fv-menu-open').forEach(function (other) {
          if (other !== item) other.classList.remove('fv-menu-open');
        });
        item.classList.add('fv-menu-open');
      };
      var scheduleClose = function () {
        if (closeTimer) clearTimeout(closeTimer);
        closeTimer = setTimeout(function () {
          item.classList.remove('fv-menu-open');
        }, 150);
      };

      if (trigger) {
        trigger.addEventListener('mouseenter', open);
        trigger.addEventListener('mouseleave', scheduleClose);
      }
      if (dropdown) {
        dropdown.addEventListener('mouseenter', open);
        dropdown.addEventListener('mouseleave', scheduleClose);
      }
    });

    var headerEl = document.getElementById('fv-main-header');
    if (headerEl) {
      window.addEventListener('scroll', function () {
        if (window.scrollY > 10) {
          headerEl.classList.add('fv-is-stuck');
        } else {
          headerEl.classList.remove('fv-is-stuck');
        }
      }, { passive: true });
    }
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Height",
      "default": 38
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Typography & Style Controls"
    },
    {
      "type": "select",
      "id": "nav_font_weight",
      "label": "Navigation Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "icon_stroke_width",
      "label": "Icons Stroke Thickness",
      "options": [
        { "value": "1.2", "label": "Thin (1.2px)" },
        { "value": "1.5", "label": "Regular (1.5px)" },
        { "value": "1.8", "label": "Medium (1.8px)" },
        { "value": "2.2", "label": "Bold (2.2px)" }
      ],
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "Color Customization"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#161D24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Navigation Text Color",
      "default": "#F4F1EA"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Badges/Hover)",
      "default": "#B5602F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border & Line Color",
      "default": "rgba(181, 96, 47, 0.25)"
    },
    {
      "type": "range",
      "id": "padding_v",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Vertical Header Padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu Trigger",
      "settings": [
        {
          "type": "text",
          "id": "menu_trigger",
          "label": "Menu Item Title",
          "info": "Enter exact top-level menu link name (e.g., Storage Units or Dining)"
        },
        {
          "type": "text",
          "id": "promo_heading",
          "label": "Promo Banner Heading",
          "default": "Zest Collection"
        },
        {
          "type": "url",
          "id": "promo_url",
          "label": "Promo Banner Link"
        },
        {
          "type": "image_picker",
          "id": "promo_image",
          "label": "Promo Card Background Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}