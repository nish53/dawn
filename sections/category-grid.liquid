{% comment %}
  Section: Dynamic Category Grid
  File Location: sections/category-grid.liquid
{% endcomment %}

<div class="fv-category-section-wrapper" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; background: {{ section.settings.section_bg }};">
  <div class="page-width">
    
    <!-- Section Header -->
    <div style="text-align: {{ section.settings.text_alignment }};">
      {%- if section.settings.eyebrow != blank -%}
        <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: {{ section.settings.accent_color }}; margin-bottom: 6px;">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 style="font-family: var(--fv-heading-font, inherit); font-size: {{ section.settings.heading_size }}px; font-weight: 700; margin: 0 0 4px; display: inline-block; color: {{ section.settings.heading_color }};">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.show_accent_bar -%}
        <div style="width: 70px; height: 5px; background: {{ section.settings.accent_color }}; border-radius: 3px; margin: 8px {% if section.settings.text_alignment == 'center' %}auto{% else %}0{% endif %} 18px; display: block;"></div>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p style="font-size: 14px; color: {{ section.settings.subheading_color }}; margin-bottom: 28px;">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}
    </div>

    <!-- Category Grid -->
    {%- if section.blocks.size > 0 -%}
      <div class="fv-category-grid" style="
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
        gap: {{ section.settings.grid_gap }}px;
      ">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- assign title = block.settings.custom_title | default: collection.title -%}
          {%- assign url = block.settings.custom_url | default: collection.url | default: '#' -%}

          <a href="{{ url }}" class="fv-category-tile" style="text-decoration: none; color: inherit; text-align: center; display: block;" {{ block.shopify_attributes }}>
            <!-- Card Image Canvas -->
            <div class="fv-category-card" style="
              border-radius: {{ section.settings.card_radius }}px;
              overflow: hidden;
              box-shadow: 0 {{ section.settings.shadow_blur }}px {{ section.settings.shadow_blur | times: 2 }}px rgba(0,0,0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
              aspect-ratio: 1/1;
              position: relative;
              border: 1px solid {{ section.settings.card_border_color }};
              background: {{ section.settings.card_fallback_bg }};
              transition: transform 0.3s ease, box-shadow 0.3s ease;
            ">
              {%- if block.settings.custom_image != blank -%}
                <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ title }}" style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease;" loading="lazy">
              {%- elsif collection.image != blank -%}
                <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ title }}" style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease;" loading="lazy">
              {%- elsif collection.products.first.featured_image != blank -%}
                <img src="{{ collection.products.first.featured_image | image_url: width: 600 }}" alt="{{ title }}" style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease;" loading="lazy">
              {%- else -%}
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #999; font-size: 12px;">Select Image</div>
              {%- endif -%}
            </div>

            <!-- Title -->
            <div style="
              font-family: var(--fv-heading-font, inherit);
              font-size: {{ section.settings.title_size }}px;
              font-weight: {{ section.settings.title_weight }};
              letter-spacing: 0.04em;
              text-transform: uppercase;
              color: {{ section.settings.heading_color }};
              margin-top: 14px;
              transition: color 0.3s ease;
            ">
              {{ title | default: "Category Title" }}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align: center; font-size: 14px; color: {{ section.settings.subheading_color }};">Add category blocks in the theme editor to build your grid.</p>
    {%- endif -%}

  </div>
</div>

<style>
  .fv-category-tile:hover .fv-category-card {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.18);
  }
  .fv-category-tile:hover img {
    transform: scale(1.05);
  }
  .fv-category-tile:hover div {
    color: {{ section.settings.accent_color }} !important;
  }

  @media (max-width: 1024px) {
    .fv-category-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr) !important;
    }
  }
  @media (max-width: 640px) {
    .fv-category-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
      gap: 12px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "BROWSE BY CATEGORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Every Room"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "show_accent_bar",
      "label": "Show Accent Bar Line",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated furniture for every corner of your home"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Grid & Card Styling"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tablet Columns",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile Columns",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Grid Gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Shadow Elevation",
      "default": 12
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "%",
      "label": "Shadow Opacity",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Category Title Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Category Title Font Weight",
      "options": [
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi-Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Color Controls"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Title Color",
      "default": "#2D2926"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#7A7267"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Eyebrow & Line)",
      "default": "#B5602F"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "rgba(0,0,0,0.05)"
    },
    {
      "type": "color",
      "id": "card_fallback_bg",
      "label": "Card Fallback Background",
      "default": "#F5F1EA"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image Override",
          "info": "Upload an image here to override the default Shopify Collection image."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Label",
          "info": "Leave blank to use the default Shopify Collection title."
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link URL",
          "info": "Leave blank to use the default Shopify Collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}